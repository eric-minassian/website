{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "semi": true,
  "singleQuote": false,
  "tabWidth": 2,
  "useTabs": false,
  "trailingComma": "all",
  "printWidth": 100,
  "bracketSpacing": true,
  "arrowParens": "always",
  "endOfLine": "lf",
  "sortImports": {},
  "sortTailwindcss": {
    "stylesheet": "src/styles/globals.css"
  },
  // `.astro` files too, with Astro's own JSX whitespace rules. oxfmt parses them with
  // @astrojs/compiler-rs, which it doesn't bundle, so it's a dev dependency here.
  "astro": true,
  "ignorePatterns": ["dist/**", ".astro/**", "pnpm-lock.yaml"]
}
