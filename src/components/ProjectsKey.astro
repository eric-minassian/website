---
// The home page's way into /projects: the apps on my platform, what each is and its page views,
// a key to the traffic horizon below (TrafficHorizon.astro). src/scripts/traffic.ts fills it once
// the platform's directory loads; until then it holds the shape of the rows to come.
import { ARROW_RIGHT } from "../lib/icons";

const placeholders = [
  { name: "5.5rem", about: "13rem" },
  { name: "3.5rem", about: "10rem" },
  { name: "4.5rem", about: "8rem" },
];
---

<section
  data-traffic
  data-state="loading"
  aria-labelledby="projects-heading"
  class="projects-key rule-above"
>
  <div class="key-head">
    <h2 id="projects-heading" class="section-heading">
      <a href="/projects" class="arrow-link link-quiet tap"
        >Projects<svg class="arrow" viewBox="0 0 16 16" aria-hidden="true"><path d={ARROW_RIGHT}></path></svg></a
      >
    </h2>
    <p class="mt-1 text-sm text-muted">Apps I run on my own platform.</p>
  </div>
  <div class="key-body">
    <div data-traffic-placeholder aria-hidden="true" class="text-sm">
      {
        placeholders.map(({ name, about }) => (
          <div class="key-row">
            <span class="key-swatch">
              <span class="block size-2 rounded-full bg-faint" />
            </span>
            <span>
              <span class="skeleton" style={{ width: name }} />
            </span>
            <span class="text-right">
              <span class="skeleton w-8" />
            </span>
            <span class="key-about">
              <span class="skeleton" style={{ width: about }} />
            </span>
          </div>
        ))
      }
    </div>
    <ul data-traffic-list class="list-none pl-0 text-sm tabular-nums" hidden></ul>
  </div>
  <!-- Says what the counts cover once there are counts; until then there's nothing to say. -->
  <p data-traffic-period class="key-period text-sm text-muted" aria-live="polite"></p>
  <noscript><p class="key-period text-sm text-muted">The traffic loads with JavaScript.</p></noscript>
</section>

<style>
  .projects-key {
    display: grid;
    grid-template-areas: "head" "body" "period";
    row-gap: 0.75rem;
    margin-top: 3rem;
    padding-top: 2rem;
  }

  .key-head {
    grid-area: head;
  }

  .key-body {
    grid-area: body;
  }

  /* A line kept for the caption, so nothing moves when it arrives with the counts. */
  .key-period {
    grid-area: period;
    min-height: 1.5em;
  }

  /* With room beside it, the key sits at the column's right edge, its counts on the toggle's line. */
  @media (width >= 40rem) {
    .projects-key {
      grid-template-columns: minmax(0, 1fr) 18rem;
      grid-template-areas: "head body" "period body";
      grid-template-rows: auto 1fr;
      column-gap: 2rem;
    }

    .key-period {
      align-self: end;
    }
  }

  /* Beside the bio on a large window, where the whitespace is separation enough. */
  @media (width >= 64rem) {
    .projects-key {
      grid-template-columns: none;
      grid-template-areas: "head" "body" "period";
      grid-template-rows: none;
      margin-top: 0;
      padding-top: 0;
      background: none;
    }

    .key-period {
      align-self: auto;
    }
  }

  .projects-key :global(.key-row) {
    display: grid;
    grid-template-columns: 1rem minmax(0, 1fr) auto;
    align-items: center;
    column-gap: 0.625rem;
    padding-block: 0.375rem;
  }

  /* What the app is, under its name, quieter and a line apart from the next. */
  .projects-key :global(.key-about) {
    grid-column: 2 / -1;
    color: var(--color-muted);
    line-height: 1.4;
    text-wrap: pretty;
  }

  .projects-key :global(.key-swatch) {
    display: grid;
    place-items: center;
  }

  .projects-key :global(.key-swatch svg) {
    display: block;
  }

  /* The name's link is only as wide as the name, and a long one ends in an ellipsis. */
  .projects-key :global(.key-name) {
    display: flex;
    min-width: 0;
    align-items: baseline;
    gap: 0.375rem;
  }

  .projects-key :global(.key-name a) {
    display: inline-flex;
    min-width: 0;
    align-items: center;
    gap: 0.25rem;
  }

  .projects-key :global(.key-name-text) {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .projects-key :global(.key-name .arrow) {
    flex: none;
  }

  .projects-key :global(.key-down) {
    flex: none;
    color: var(--color-alert);
  }

  .projects-key :global(li.key-row) {
    transition: opacity 150ms;
  }

  /* Pointing at (or focusing) one app in the key quiets the others, here and on the horizon. */
  [data-focus] :global(li.key-row:not(.is-focused)) {
    opacity: 0.45;
  }
</style>
