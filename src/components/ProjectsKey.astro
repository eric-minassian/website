---
// The home page's way into /projects: the apps on my platform, what each is and its page views,
// a key to the traffic horizon below (TrafficHorizon.astro). src/scripts/traffic.ts fills it once
// the platform's directory loads; until then it holds the shape of the rows to come.
import { ARROW_RIGHT } from "../lib/icons";

// The shape of a typical key: the busiest app's description over two lines, the others' over one,
// so that what arrives takes the room the placeholder kept.
const placeholders = [
  { name: "5.5rem", about: ["15rem", "9rem"] },
  { name: "3.5rem", about: ["12rem"] },
  { name: "4.5rem", about: ["8rem"] },
];
---

<section
  data-traffic
  data-state="loading"
  aria-labelledby="projects-heading"
  class="projects-key rule-above"
>
  <!-- The section's name, and on its line (or under it, where narrow) what the counts cover. -->
  <div class="key-head">
    <h2 id="projects-heading" class="section-heading">
      <a href="/projects" class="arrow-link link-quiet tap">
        <span class="key-title">Projects</span>
        <svg class="arrow" viewBox="0 0 16 16" aria-hidden="true">
          <path d={ARROW_RIGHT}></path>
        </svg>
      </a>
    </h2>
    <p data-traffic-period class="key-period text-sm text-muted" aria-live="polite"></p>
  </div>
  <noscript>
    <p class="text-sm text-muted">The traffic loads with JavaScript.</p>
  </noscript>
  <div class="key-rows">
    <!-- Why there are no rows (it couldn't load, or nothing's running), where they'd be. -->
    <p data-traffic-note class="text-sm text-muted" aria-live="polite" hidden></p>
    <div data-traffic-placeholder aria-hidden="true" class="text-sm">
      {placeholders.map(({ name, about }, i) => (
        <div class="key-row" style={{ "--i": i }}>
          <span class="key-swatch">
            <span class="block size-2 rounded-full bg-faint" />
          </span>
          <span>
            <span class="skeleton" style={{ width: name }} />
          </span>
          <span class="text-right">
            <span class="skeleton w-8" />
          </span>
          <span class="key-about">
            {about.map((width) => (
              <span class="block">
                <span class="skeleton" style={{ width }} />
              </span>
            ))}
          </span>
        </div>
      ))}
    </div>
    <ul data-traffic-list class="list-none pl-0 text-sm tabular-nums" hidden></ul>
  </div>
</section>

<style>
  .projects-key {
    container: key / inline-size;
    display: grid;
    row-gap: 0.5rem;
    margin-top: 3rem;
    padding-top: 2rem;
  }

  /*
   * What the counts cover heads their column, on the section name's line where there's room for
   * both; where there isn't, on a line of its own under it, kept from the start so nothing moves
   * when it arrives.
   */
  .key-head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    column-gap: 1rem;
  }

  .key-period {
    margin-left: auto;
    text-align: right;
    text-wrap: balance;
  }

  @container key (width < 21rem) {
    .key-period {
      flex-basis: 100%;
      min-height: 1.5em;
    }
  }

  /*
   * The rows, over which the placeholders fade out (src/lib/leave.ts). They keep room for a full
   * key (three rows, five lines of description between them), so what arrives seldom needs more
   * and the page below doesn't move; no more than that, or a window that just fits would scroll.
   */
  .key-rows {
    position: relative;
    min-height: calc(3 * (0.75rem + 1.5 * var(--text-sm)) + 5 * 1.45 * var(--text-sm));
    margin-top: 0.25rem;
  }

  /* Beside the bio once there's room (index.astro), where the whitespace is separation enough. */
  @media (width >= 40rem) {
    .projects-key {
      margin-top: 0;
      padding-top: 0;
      background: none;
    }
  }

  .projects-key :global(.key-row) {
    display: grid;
    grid-template-columns: 1em minmax(0, 1fr) auto;
    align-items: center;
    column-gap: 0.625rem;
    padding-block: 0.375rem;
  }

  /*
   * What the app is, under its name, quieter; rows take their own height, evenly spaced. Never more
   * than two lines (three while the key shares the column evenly with the bio and is narrow), the
   * others' names one, so the key never outgrows the room kept for it; the whole text is on
   * /projects.
   */
  .projects-key :global(.key-about) {
    grid-column: 2 / -1;
    display: -webkit-box;
    overflow: hidden;
    color: var(--color-muted);
    line-height: 1.45;
    text-wrap: pretty;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
    line-clamp: 2;
  }

  .projects-key :global(.key-about.key-others) {
    -webkit-line-clamp: 1;
    line-clamp: 1;
  }

  @media (width >= 40rem) and (width < 48rem) {
    .projects-key :global(.key-about:not(.key-others)) {
      -webkit-line-clamp: 3;
      line-clamp: 3;
    }

    .key-rows {
      min-height: calc(3 * (0.75rem + 1.5 * var(--text-sm)) + 7 * 1.45 * var(--text-sm));
    }
  }

  .projects-key :global(.key-swatch) {
    display: grid;
    place-items: center;
  }

  /* A patch of the band's dots as tall as the text, at any text size. */
  .projects-key :global(.key-swatch svg) {
    display: block;
    width: 1em;
    height: 1em;
  }

  /* The name's link is only as wide as the name, and a long one ends in an ellipsis. */
  .projects-key :global(.key-name) {
    display: flex;
    min-width: 0;
    align-items: baseline;
    gap: 0.375rem;
  }

  /* Names in the ledger's weight, a step above what they are. */
  .projects-key :global(.key-name a) {
    display: inline-flex;
    min-width: 0;
    align-items: center;
    gap: 0.2rem;
    font-weight: 500;
  }

  .projects-key :global(.key-name-text) {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .projects-key :global(.key-name .arrow) {
    flex: none;
  }

  .projects-key :global(.key-down) {
    flex: none;
    color: var(--color-alert);
  }

  .projects-key :global(li.key-row) {
    transition: opacity 150ms;
  }

  /* Pointing at (or focusing) one app in the key quiets the others, here and on the horizon. */
  [data-focus] :global(li.key-row:not(.is-focused)) {
    opacity: 0.75;
  }

  /* Its swatch comes forward in ink, as its band does on the horizon. */
  .projects-key :global(li.key-row.is-focused .key-swatch svg) {
    fill: var(--color-ink);
  }
</style>
