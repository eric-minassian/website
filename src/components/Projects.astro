---
// The apps running on my platform, as a ledger: what each is, when it last shipped, and its page
// views over the last 30 days. The browser fills it from the platform's directory as the page
// loads (src/scripts/projects.ts), so it's current without a deploy.

interface Props {
  /** The id of the heading that names the list. */
  labelledBy: string;
}

const { labelledBy } = Astro.props;
---

<div data-projects data-state="loading">
  <ul
    data-projects-list
    aria-labelledby={labelledBy}
    aria-busy="true"
    hidden
    class="mt-6 grid list-none grid-cols-[1fr_auto_auto] gap-x-4 border-b border-faint pl-0 sm:grid-cols-[max-content_1fr_auto_auto] sm:gap-x-6"
  >
  </ul>
  <p data-projects-note class="mt-3 text-sm text-muted" aria-live="polite"></p>
  <noscript><p class="text-sm text-muted">The list loads with JavaScript.</p></noscript>
</div>

<script>
  import { initProjects } from "../scripts/projects";
  void initProjects();
</script>
