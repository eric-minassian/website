---
// The apps running on my platform, as a ledger: what each is, when it last shipped, and its page
// views over the last 30 days. The browser fills it from the platform's directory as the page
// loads (src/scripts/projects.ts), so it's current without a deploy; until then it holds the shape
// of the rows to come.

interface Props {
  /** The id of the heading that names the list. */
  labelledBy: string;
}

const { labelledBy } = Astro.props;
const placeholders = [
  { name: "4.5rem", about: "85%" },
  { name: "3.5rem", about: "70%" },
  { name: "5rem", about: "90%" },
  { name: "3rem", about: "60%" },
];
---

<div data-projects data-state="loading" class="ledger mt-6">
  <!-- What the totals cover, above their column, once there are totals. -->
  <p data-projects-head class="ledger-head text-sm text-muted"></p>
  <div class="ledger-rows">
  <div data-projects-placeholder aria-hidden="true" class="ledger-grid rule-below">
    {
      placeholders.map(({ name, about }, i) => (
        <div class="ledger-row rule-above" style={{ "--i": i }}>
          <span class="ledger-name">
            <span class="skeleton" style={{ width: name }} />
          </span>
          <span class="ledger-about">
            <span class="ledger-description">
              <span class="skeleton" style={{ width: about }} />
            </span>
            <span class="ledger-meta text-sm">
              <span class="skeleton" style={{ width: "8rem" }} />
            </span>
          </span>
          <span class="ledger-spark">
            <span class="skeleton spark-skeleton" />
          </span>
          <span class="ledger-total">
            <span class="skeleton w-8" />
          </span>
        </div>
      ))
    }
  </div>
  <ul data-projects-list aria-labelledby={labelledBy} aria-busy="true" hidden class="ledger-grid rule-below list-none pl-0">
  </ul>
  </div>
  <p data-projects-note class="ledger-note mt-4 text-sm text-muted" aria-live="polite"></p>
  <noscript><p class="mt-4 text-sm text-muted">The list loads with JavaScript.</p></noscript>
</div>

<style>
  /* The rows, over which the placeholders fade out (src/lib/leave.ts). */
  .ledger-rows {
    position: relative;
  }

  .ledger-head {
    min-height: 1.5em;
    margin-bottom: 0.5rem;
    text-align: right;
  }

  /*
   * On a phone: the name and its total on the first line, what the app is below, and its days
   * ending the line that says when it was deployed, under the total.
   */
  .ledger-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    column-gap: 1rem;
  }

  /* With room for it, what the app is sits beside its name, and its days beside that. */
  @media (width >= 52rem) {
    .ledger-grid {
      grid-template-columns: minmax(7rem, max-content) minmax(0, 1fr) auto 3.75rem;
      column-gap: 2rem;
    }
  }

  .ledger :global(.ledger-row) {
    grid-column: 1 / -1;
    display: grid;
    grid-template-columns: subgrid;
    align-items: baseline;
    row-gap: 0.375rem;
    padding-block: 1.125rem;
  }

  /* The name, only as wide as itself (a long one ends in an ellipsis), and whether it's down. */
  .ledger :global(.ledger-name) {
    grid-column: 1;
    grid-row: 1;
    display: flex;
    min-width: 0;
    max-width: 16rem;
    align-items: baseline;
    gap: 0.5rem;
  }

  .ledger :global(.ledger-name a) {
    display: inline-flex;
    min-width: 0;
    align-items: center;
    gap: 0.2rem;
    font-weight: 500;
  }

  .ledger :global(.ledger-name-text) {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .ledger :global(.ledger-name .arrow-out) {
    flex: none;
  }

  .ledger :global(.ledger-down) {
    flex: none;
    color: var(--color-alert);
  }

  /*
   * On a phone what the app is runs under its name and total, and the line saying when it was
   * deployed ends in its days, under the total.
   */
  .ledger :global(.ledger-about) {
    display: contents;
  }

  .ledger :global(.ledger-description) {
    grid-column: 1 / -1;
    grid-row: 2;
  }

  /*
   * As wide as its words, all on one line, so projects.ts can measure what the dots have beside
   * it; it and the dots stand on one baseline.
   */
  .ledger :global(.ledger-meta) {
    grid-column: 1;
    grid-row: 3;
    align-self: baseline;
    width: fit-content;
    white-space: nowrap;
  }

  /* Where the line and the dots won't both fit (projects.ts), the dots take a line of their own. */
  .ledger :global(.spark-below .ledger-meta) {
    grid-column: 1 / -1;
  }

  .ledger :global(.spark-below .ledger-spark) {
    grid-column: 1 / -1;
    grid-row: 4;
  }

  .ledger :global(.ledger-sep) {
    margin-inline: 0.4em;
  }

  .ledger :global(.ledger-total) {
    grid-column: 2;
    grid-row: 1;
    text-align: right;
    font-variant-numeric: tabular-nums;
  }

  .ledger :global(.ledger-spark) {
    grid-column: 2;
    grid-row: 3;
    justify-self: end;
    align-self: baseline;
    position: relative;
    cursor: crosshair;
    touch-action: pan-y;
  }

  /*
   * The dots stand on the line: the strip under them for the keyboard's mark (FOOT in projects.ts)
   * hangs below it rather than lifting them.
   */
  .ledger :global(.ledger-spark svg) {
    margin-bottom: -5px;
  }

  /* A taller target than the dots, for a finger or an unsteady pointer. */
  .ledger :global(.ledger-spark::before) {
    content: "";
    position: absolute;
    inset: -0.5rem -0.25rem;
  }

  /* Focused, the dots read out a day (today, to begin with), underlined like the horizon's. */
  .ledger :global(.ledger-spark:focus-visible) {
    outline: none;
  }

  .ledger :global(.spark-mark) {
    visibility: hidden;
  }

  .ledger :global(.ledger-spark:focus-visible[data-day] .spark-mark) {
    visibility: visible;
  }

  /*
   * A day's reading. On a phone it takes the place of the line the dots end while it shows,
   * starting where that line does (`--reach`, set by projects.ts), on its baseline, so nothing moves.
   */
  .ledger :global(.spark-reading) {
    position: absolute;
    left: calc(-1 * var(--reach, 0px));
    /* Its baseline on the dots' ground, where the line's was. */
    bottom: -0.22em;
    color: var(--color-ink);
    white-space: nowrap;
    line-height: 1;
  }

  .ledger :global(.ledger-spark:not([data-day]) .spark-reading) {
    visibility: hidden;
  }

  @media (width < 52rem) {
    .ledger :global(.ledger-grid:not(.spark-below) .ledger-row:has(.ledger-spark[data-day]) .ledger-meta) {
      visibility: hidden;
    }
  }

  /* With nothing to list (it couldn't load, or nothing's running), the note takes the list's place. */
  .ledger:is([data-state="error"], [data-state="empty"]) .ledger-head {
    display: none;
  }

  .ledger:is([data-state="error"], [data-state="empty"]) .ledger-note {
    margin-top: 0;
  }

  @media (width >= 52rem) {
    /* Beside the name, what the app is runs on to its days, the line when it was deployed under it. */
    .ledger :global(.ledger-about) {
      grid-column: 2;
      grid-row: 1;
      display: flex;
      flex-direction: column;
      gap: 0.375rem;
    }

    .ledger :global(.ledger-meta) {
      align-self: auto;
      width: auto;
      white-space: normal;
    }

    /* Beside the description the dots stand on the line's baseline, the reading under them. */
    .ledger :global(.ledger-spark) {
      grid-column: 3;
      grid-row: 1;
      justify-self: end;
      align-self: baseline;
    }

    .ledger :global(.spark-reading) {
      top: calc(100% + 5px + 0.25rem);
      right: 0;
      bottom: auto;
      left: auto;
    }

    .ledger :global(.ledger-total) {
      grid-column: 4;
    }
  }

  /*
   * A sparkline before its data: a placeholder along its ground, its width and height (`dotsFor`
   * in projects.ts: 30 days at 5px, seven rows; closer on a phone too narrow for that beside the
   * "Deployed" line).
   */
  .spark-skeleton {
    display: block;
    width: 150px;
    height: 6px;
    margin-block: 29px 0;
  }

  /* A phone's column too narrow for 5px beside the "Deployed" line: 4.5px, or 4px. */
  @media (width < 379px) {
    .spark-skeleton {
      width: 135px;
    }
  }

  @media (width < 364px) {
    .spark-skeleton {
      width: 120px;
    }
  }

  @media (width >= 52rem) {
    .spark-skeleton {
      width: 150px;
    }
  }

  .ledger :global(.ledger-spark path) {
    transition: opacity 120ms;
  }

  /*
   * A day being read comes forward in ink, even a day with no views; the other days step back, and
   * the ground stays as it is.
   */
  .ledger :global(.ledger-spark[data-day] path[data-day]:not(.is-day)) {
    opacity: 0.25;
  }

  .ledger :global(.ledger-spark[data-day] path.is-day) {
    fill: var(--color-ink);
  }
</style>

<script>
  import { initProjects } from "../scripts/projects";
  void initProjects();
</script>
