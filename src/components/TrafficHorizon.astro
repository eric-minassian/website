---
// The projects' traffic as a halftone horizon at the foot of the home page: a block of dots per
// day in the page's column, the oldest day at its left edge and today at its right, standing on a
// ground row of faint dots that runs from one edge of the window to the other. The ground is drawn
// in CSS while the data loads; src/scripts/traffic.ts then raises the strata on a ground of their
// own and names the busiest day. Pointing at a day (or tapping it, or focusing the strata and
// using the arrow keys) reads it out above its block and, app by app, in the key
// (ProjectsKey.astro). The chart takes whatever height the window leaves it, within limits.
---

<div data-horizon data-state="loading" class="horizon horizon-frame">
  <div class="horizon-plot ground">
    <div data-horizon-chart class="horizon-chart" aria-hidden="true"></div>
    <div
      data-horizon-scrub
      class="horizon-scrub"
      role="slider"
      tabindex="-1"
      aria-label="Page views by day"
      aria-valuemin="0"
      hidden
    >
    </div>
    <span data-horizon-peak class="horizon-note text-sm text-muted tabular-nums" aria-hidden="true" hidden
    ></span>
    <span data-horizon-guide class="horizon-guide" aria-hidden="true" hidden></span>
    <span data-horizon-mark class="horizon-mark" aria-hidden="true" hidden></span>
    <span data-horizon-since class="horizon-note text-sm text-muted" aria-hidden="true" hidden></span>
    <span data-horizon-label class="horizon-note text-sm tabular-nums" aria-hidden="true" hidden></span>
  </div>
  <div data-horizon-axis class="horizon-axis page text-sm text-muted tabular-nums" aria-hidden="true">
    <span data-horizon-start>&nbsp;</span>
    <span data-horizon-weeks class="horizon-weeks"></span>
    <span data-horizon-today>Today so far</span>
  </div>
</div>

<script is:inline>
  // A window a little short of the whole page would scroll just to show the dates: there, the
  // strata give those pixels up (`--give`) and the page fits, as long as they keep 7rem; past that
  // the page scrolls. Run as the page is read, so the first paint already fits, and again whenever
  // the page's height or the window's changes.
  (() => {
    const horizon = document.querySelector("[data-horizon]");
    const plot = horizon.querySelector(".horizon-plot");
    const fit = () => {
      const give = parseFloat(horizon.style.getPropertyValue("--give")) || 0;
      const rem = parseFloat(getComputedStyle(document.documentElement).fontSize);
      const most = parseFloat(getComputedStyle(plot).minHeight) + give - 7 * rem;
      const over = document.documentElement.scrollHeight - innerHeight + give;
      const next = over > 0 && over <= most ? Math.ceil(over) : 0;
      if (next !== give) horizon.style.setProperty("--give", `${next}px`);
    };
    fit();
    new ResizeObserver(fit).observe(document.body);
    addEventListener("resize", fit);
  })();
</script>

<style>
  /* Grows into the room the page leaves, three parts to the sky's one, standing on the window's foot. */
  .horizon {
    display: flex;
    flex: 3 1 0;
    flex-direction: column;
    justify-content: flex-end;
  }

  /* Taller on a tall window, so the room goes to the strata rather than to empty sky. */
  .horizon-plot {
    position: relative;
    flex: 1 1 auto;
    min-height: calc(7rem - var(--give, 0px));
    max-height: min(56vh, 48rem);
    /* Its own box paints nothing (the ground is a layer below); see `::before`. */
    background: none;
    /*
     * What moves inside (the readings, as a finger drags across the days) stays inside, as far as
     * the page's layout knows: without it, a touch drag reaching today scrolled the page in Chromium.
     */
    contain: layout;
  }

  /*
   * While the data loads, the ground row (`.ground` in globals.css): a layer one dot high pinned to
   * the plot's foot, which stays at the window's foot, so as the key above settles and the plot
   * grows or shrinks, nothing drawn moves; the strata's own ground then lands dot for dot on it.
   */
  .horizon-plot::before {
    content: "";
    position: absolute;
    /* Above the strip kept for the weeks' ticks (FOOT in traffic.ts). */
    inset: auto 0 6px;
    height: var(--step);
    background-image: var(--ground);
    background-size: var(--step) var(--step);
    background-repeat: repeat-x;
    background-position: calc((100cqw - var(--column)) / 2) bottom;
  }

  @media (width < 40rem) {
    .horizon-plot {
      min-height: calc(10rem - var(--give, 0px));
    }
  }

  /* On a short window the strata give up a little height, and the dates a little air, to fit. */
  @media (width >= 40rem) and (height < 40rem) {
    .horizon-plot {
      min-height: calc(6rem - var(--give, 0px));
    }

    .horizon-axis {
      padding-bottom: 0.5rem;
    }
  }

  .horizon-chart {
    position: absolute;
    inset: 0;
  }

  /*
   * A drawn horizon brings its own ground. One with nothing to stand on it (an error, nothing
   * running) keeps the bare ground, as the 404 page does.
   */
  .horizon-plot:has(> [data-drawn])::before {
    display: none;
  }

  .horizon-chart :global(svg) {
    display: block;
  }

  /* The strata rise from the ground a row at a time, the whole rise under half a second. */
  .horizon-chart :global(.rise > path[data-band]) {
    animation: rise 360ms var(--ease-out-soft) both;
    animation-delay: calc(var(--row) * var(--stagger, 20ms));
  }

  .horizon-chart :global(path) {
    transition: opacity 150ms;
  }

  /* An app picked out in the key, or a day being read: everything else steps back. */
  .horizon-chart :global(path.is-quiet),
  .horizon-chart :global(.is-reading > path[data-band]) {
    opacity: 0.2;
  }

  /* Today's top row, still counting: rings rather than dots (the date below says "so far"). */
  .horizon-chart :global(path.today) {
    stroke-width: 1;
  }

  /* While the data loads, a light passes slowly along the ground. */
  [data-state="loading"] .horizon-plot::after {
    content: "";
    position: absolute;
    inset: auto 0 6px;
    height: var(--step);
    background-image: radial-gradient(circle, var(--color-muted) 0.65px, transparent 1.15px);
    background-size: var(--step) var(--step);
    background-repeat: repeat-x;
    background-position: calc((100cqw - var(--column)) / 2) bottom;
    mask-image: linear-gradient(90deg, transparent, black, transparent);
    mask-size: 30% 100%;
    mask-repeat: no-repeat;
    animation: sweep 2.4s ease-in-out infinite;
  }

  /* Over the strata only, not the ground beside them: where a day can be read. */
  .horizon-scrub {
    position: absolute;
    top: 0;
    bottom: 0;
    cursor: crosshair;
    touch-action: pan-y;
  }

  /*
   * Focused, the strata read out a day (today, to begin with), and the day in hand is underlined
   * in the foot (`.horizon-mark`): the focus is the day, not the whole chart.
   */
  .horizon-scrub:focus-visible {
    outline: none;
  }

  .horizon-mark {
    position: absolute;
    top: 0;
    left: 0;
    height: 2px;
    background-color: var(--color-ink);
    pointer-events: none;
  }

  /* "Today so far" at the right edge; the other dates are placed under their days by the script. */
  .horizon-axis {
    position: relative;
    display: flex;
    justify-content: flex-end;
    white-space: nowrap;
    padding-top: 0.5rem;
    padding-bottom: 1rem;
    opacity: 0;
    transition: opacity 400ms;
  }

  /* The dates arrive with the strata; a horizon that can't load stays bare. */
  [data-state="ready"] .horizon-axis {
    opacity: 1;
  }

  /*
   * On a phone, where the page scrolls down to it, a horizon with nothing to stand on it (it
   * couldn't load, or nothing's running) gives its room up: the key above says why.
   */
  @media (width < 40rem) {
    .horizon:is([data-state="error"], [data-state="empty"]) {
      display: none;
    }
  }

  /* Today's count, when today is the busiest day: dotted like the busiest day's note, and read alike. */
  .horizon-axis :global(.horizon-count) {
    text-decoration: underline dotted;
    text-decoration-color: color-mix(in srgb, currentColor 60%, transparent);
    text-underline-offset: 0.25em;
    cursor: default;
  }

  [data-horizon-start] {
    position: absolute;
    top: 0.5rem;
    left: 0;
  }

  /* The weeks' dates, each under its tick, as many as there's room for (traffic.ts). */
  .horizon-weeks {
    position: absolute;
    inset: 0.5rem 0 auto 0;
    pointer-events: none;
  }

  .horizon-weeks :global(span) {
    position: absolute;
    top: 0;
    left: 0;
    white-space: nowrap;
  }

  /* A thread from a day's reading down to the top of its block. */
  .horizon-guide {
    position: absolute;
    top: 0;
    left: 0;
    width: 1px;
    background-color: var(--color-muted);
    pointer-events: none;
  }

  /* Notes set by the script in the headroom above the strata, clear of every block. */
  .horizon-note {
    position: absolute;
    top: 0;
    left: 0;
    white-space: nowrap;
    line-height: 1;
    pointer-events: none;
  }

  [data-horizon-label] {
    color: var(--color-ink);
  }

  /*
   * The busiest day's note is dotted underneath, like a term with more to it: pointing at it, or
   * tapping it, reads that day, and the other days can be read the same way.
   */
  [data-horizon-peak] {
    text-decoration: underline dotted;
    text-decoration-color: color-mix(in srgb, currentColor 60%, transparent);
    text-underline-offset: 0.25em;
  }

  /* The busiest day's note waits for its block to rise beneath it. */
  [data-horizon-peak].after-rise {
    animation: settle 300ms ease-out 450ms both;
  }

  /* Without JavaScript nothing is on its way: the bare ground stays, as on the 404 page. */
  @media (prefers-reduced-motion: reduce) {
    [data-state="loading"] .horizon-plot::after {
      display: none;
    }
  }

  :global(.no-js) [data-state="loading"] .horizon-plot::after {
    display: none;
  }

  @keyframes sweep {
    from {
      mask-position: -50% 0;
    }
    to {
      mask-position: 150% 0;
    }
  }

  @keyframes settle {
    from {
      opacity: 0;
    }
  }

  @keyframes rise {
    from {
      opacity: 0;
      transform: translateY(3px);
    }
  }
</style>

<script>
  import { initTraffic } from "../scripts/traffic";
  void initTraffic();
</script>
