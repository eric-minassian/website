---
// Flips between light and dark (src/scripts/theme.ts). The icon shows the theme a click will
// switch to, like the button's label: the moon on a light page, the sun on a dark one, drawn on the
// arrows' grid in their stroke, the sun's rays in the horizon's dots. It follows the `dark` class
// the head script sets before the first paint, so it's right before any other JavaScript runs.
const iconClass = "theme-icon absolute inset-0 m-auto size-5";
---

<button
  data-theme-toggle
  type="button"
  aria-label="Switch theme"
  title="Switch theme"
  class="theme-toggle relative -my-2 -mr-3 size-11 shrink-0 cursor-pointer rounded-full text-muted transition-[color,background-color,scale] duration-150 hover:bg-ink/6 hover:text-ink focus-visible:outline-offset-0 active:scale-92"
>
  <svg data-theme-icon="light" class={iconClass} viewBox="0 0 16 16" aria-hidden="true">
    <circle cx="8" cy="8" r="2.9" fill="none" stroke="currentColor" stroke-width="1.2"></circle>
    <path fill="currentColor" d="M12.95 8.00a.95 .95 0 1 0 1.9 0a.95 .95 0 1 0 -1.9 0M11.22 12.17a.95 .95 0 1 0 1.9 0a.95 .95 0 1 0 -1.9 0M7.05 13.90a.95 .95 0 1 0 1.9 0a.95 .95 0 1 0 -1.9 0M2.88 12.17a.95 .95 0 1 0 1.9 0a.95 .95 0 1 0 -1.9 0M1.15 8.00a.95 .95 0 1 0 1.9 0a.95 .95 0 1 0 -1.9 0M2.88 3.83a.95 .95 0 1 0 1.9 0a.95 .95 0 1 0 -1.9 0M7.05 2.10a.95 .95 0 1 0 1.9 0a.95 .95 0 1 0 -1.9 0M11.22 3.83a.95 .95 0 1 0 1.9 0a.95 .95 0 1 0 -1.9 0"></path>
  </svg>
  <svg data-theme-icon="dark" class={iconClass} viewBox="0 0 16 16" aria-hidden="true">
    <path
      fill="none"
      stroke="currentColor"
      stroke-width="1.2"
      stroke-linejoin="round"
      d="M7.31 2.64A5.6 5.6 0 1 0 13.58 8.72A4.5 4.5 0 0 1 7.31 2.64Z"
    ></path>
  </svg>
</button>

<style>
  /* The icon going fades out quickly; the one coming turns in just after, never both at half. */
  .theme-icon {
    opacity: 0;
    rotate: -40deg;
    scale: 0.7;
    transition:
      opacity 90ms ease-out,
      rotate 200ms ease-out,
      scale 200ms ease-out;
  }

  :global(html:not(.dark)) [data-theme-icon="dark"],
  :global(html.dark) [data-theme-icon="light"] {
    opacity: 1;
    rotate: 0deg;
    scale: 1;
    transition:
      opacity 160ms ease-out 50ms,
      rotate 320ms var(--ease-out-soft) 60ms,
      scale 320ms var(--ease-out-soft) 60ms;
  }
</style>
