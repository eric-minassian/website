---
import ThemeToggle from "../components/ThemeToggle.astro";
import { SITE } from "../lib/site";
import { getThemeScript } from "../scripts/theme";
import "../styles/globals.css";

import newsreaderLatin from "@fontsource-variable/newsreader/files/newsreader-latin-wght-normal.woff2?url";

interface Props {
  title?: string;
  description?: string;
  noindex?: boolean;
}

const { title = SITE.name, description = SITE.description, noindex = false } = Astro.props;

const site = Astro.site ?? new URL(SITE.url);
const siteUrl = site.origin;
const canonicalUrl = new URL(Astro.url.pathname, site).href;
const ogImage = `${siteUrl}/og-image.png`;
const gaId = SITE.gaId;

const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebSite",
      "@id": `${siteUrl}/#website`,
      url: siteUrl,
      name: SITE.name,
      description,
      publisher: { "@id": `${siteUrl}/#person` },
    },
    {
      "@type": "Person",
      "@id": `${siteUrl}/#person`,
      name: SITE.name,
      givenName: "Eric",
      familyName: "Minassian",
      url: siteUrl,
      image: ogImage,
      description,
      jobTitle: "Software Engineer & Tech Lead",
      worksFor: {
        "@type": "Organization",
        name: "Amazon",
        url: "https://amazon.com",
      },
      alumniOf: {
        "@type": "CollegeOrUniversity",
        name: "University of California, Irvine",
        url: "https://uci.edu",
      },
      knowsAbout: ["Software Engineering", "Payments Systems", "Distributed Systems"],
      sameAs: [SITE.github, SITE.linkedin],
    },
    {
      "@type": "ProfilePage",
      "@id": `${siteUrl}/#profilepage`,
      url: siteUrl,
      name: SITE.name,
      mainEntity: { "@id": `${siteUrl}/#person` },
    },
  ],
};
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="preload" as="font" type="font/woff2" href={newsreaderLatin} crossorigin="anonymous" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" sizes="48x32x16" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content={SITE.name} />
    <link rel="canonical" href={canonicalUrl} />
    <meta name="robots" content={noindex ? "noindex, nofollow" : "index, follow"} />
    <link rel="me" href={SITE.github} />
    <link rel="me" href={SITE.linkedin} />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:locale" content="en_US" />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Eric Minassian - Software Engineer & Tech Lead" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content="Eric Minassian - Software Engineer & Tech Lead" />

    <meta name="theme-color" content="#f8f5ed" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#171717" media="(prefers-color-scheme: dark)" />

    <script is:inline define:vars={{ gaId }}>
      function queueGtag() {
        window.dataLayer.push(arguments);
      }

      (() => {
        const measurementId = gaId;
        const isProduction = window.location.hostname === "www.ericminassian.com";
        const isBot = navigator.webdriver === true;
        if (!isProduction || isBot) return;

        window.dataLayer = window.dataLayer || [];
        window.gtag = window.gtag || queueGtag;

        let analyticsLoaded = false;

        const loadAnalytics = () => {
          if (analyticsLoaded) return;
          analyticsLoaded = true;

          const script = document.createElement("script");
          script.async = true;
          script.src = `https://www.googletagmanager.com/gtag/js?id=${measurementId}`;
          document.head.append(script);

          window.gtag("js", new Date());
          window.gtag("config", measurementId, { send_page_view: false });
          window.gtag("event", "page_view", {
            page_title: document.title,
            page_location: window.location.href,
          });
        };

        const scheduleAnalyticsLoad = () => {
          if ("requestIdleCallback" in window) {
            window.requestIdleCallback(loadAnalytics, { timeout: 3_000 });
            return;
          }

          window.setTimeout(loadAnalytics, 2_000);
        };

        const loadOnInteraction = () => {
          loadAnalytics();
          window.removeEventListener("pointerdown", loadOnInteraction);
          window.removeEventListener("keydown", loadOnInteraction);
        };

        window.addEventListener("load", scheduleAnalyticsLoad, { once: true });
        window.addEventListener("pointerdown", loadOnInteraction, { once: true, passive: true });
        window.addEventListener("keydown", loadOnInteraction, { once: true });

        document.addEventListener("click", (event) => {
          if (!(event.target instanceof Element)) return;

          const link = event.target.closest("a[href]");
          if (!link) return;

          const href = link.getAttribute("href");
          if (!href) return;

          const isExternal = href.startsWith("http") || href.startsWith("mailto:");
          if (!isExternal) return;

          window.gtag("event", "click", {
            event_category: href.startsWith("mailto:") ? "email" : "outbound",
            event_label: link.textContent.trim(),
            link_url: href,
          });
        });

        document.addEventListener("click", (event) => {
          if (!(event.target instanceof Element)) return;
          if (!event.target.closest("[data-theme-toggle]")) return;

          const themes = ["system", "dark", "light"];
          const current = localStorage.getItem("theme") || "system";
          const next = themes[(themes.indexOf(current) + 1) % themes.length];

          window.gtag("event", "theme_toggle", {
            event_category: "engagement",
            event_label: next,
          });
        });
      })();
    </script>

    <script is:inline type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
    <script is:inline set:html={getThemeScript()}></script>
    <script>
      import { initTheme } from "../scripts/theme";
      initTheme();
    </script>
  </head>

  <body class="mx-auto max-w-[650px] px-8 py-16">
    <main class="w-full md:mt-16">
      <slot />
    </main>
    <footer class="mt-16 flex justify-center">
      <ThemeToggle />
    </footer>
  </body>
</html>
