---
import Layout from "../layouts/Layout.astro";
import { ARROW_RIGHT } from "../lib/icons";
import { SITE } from "../lib/site";

const ways = [
  { href: "/", text: "Home" },
  { href: "/projects", text: "Projects" },
];
---

<Layout title={`Page not found – ${SITE.name}`} noindex page="Not found">
  <div class="page not-found mt-2 mb-16">
    <p class="lead measure">
      There’s no page at <span data-missing-path class="break-all">this address</span>.
    </p>
    <nav aria-label="Elsewhere on the site" class="elsewhere">
      <ul class="list-none space-y-2 pl-0">
        {
          ways.map(({ href, text }) => (
            <li>
              <a href={href} class="section-heading arrow-link link-quiet tap">
                {text}
                <svg class="arrow" viewBox="0 0 16 16" aria-hidden="true">
                  <path d={ARROW_RIGHT} />
                </svg>
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>
  <!-- The home page's horizon, with no traffic on it: its ground, where it stands at the window's foot. -->
  <div class="horizon-frame mt-auto" aria-hidden="true">
    <div class="ground bare-ground"></div>
  </div>
</Layout>

<style>
  /* The same step as a section's name: a sentence meant to be read first. */
  .lead {
    font-size: 1.25rem;
    line-height: 1.4;
  }

  @media (width >= 40rem) {
    .lead {
      font-size: 1.375rem;
    }
  }

  .elsewhere {
    margin-top: 2rem;
  }

  .bare-ground {
    height: var(--step);
    margin-bottom: var(--horizon-foot);
  }

  /* Laid out like the home page: the sentence in the text's place, the ways on in the key's. */
  @media (width >= 43rem) {
    .not-found {
      display: grid;
      grid-template-columns: minmax(20rem, 34rem) minmax(16rem, 21rem);
      justify-content: space-between;
      column-gap: 2rem;
      align-items: baseline;
    }

    .elsewhere {
      margin-top: 0;
    }
  }
</style>

<script>
  // Name the address that was asked for; without JavaScript the sentence still reads.
  const path = document.querySelector("[data-missing-path]");
  if (path && location.pathname !== "/404") {
    let shown = location.pathname;
    try {
      shown = decodeURIComponent(shown);
    } catch {
      // A malformed escape: show the address as it came.
    }
    path.textContent = `“${shown}”`;
  }
</script>
