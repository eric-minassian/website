---
import ProjectsKey from "../components/ProjectsKey.astro";
import TrafficHorizon from "../components/TrafficHorizon.astro";
import Layout from "../layouts/Layout.astro";
import { SITE } from "../lib/site";

const external = { target: "_blank", rel: "noopener noreferrer" };
---

<Layout>
  <div class="page home mt-2">
    <article class="measure">
      <p>
        Software engineer and tech lead at <a href="https://amazon.com" {...external} itemprop="worksFor">Amazon</a>,
        working on <a href="https://leo.amazon.com/" {...external}>Leo</a>.
      </p>
      <p class="mt-3">
        Previously led payments software at <a href="https://tech.walmart.com" {...external}>Walmart</a>.
        CS&nbsp;+&nbsp;Business from <a href="https://uci.edu" {...external} itemprop="alumniOf">UC&nbsp;Irvine</a>, summa&nbsp;cum&nbsp;laude.
      </p>
      <nav aria-label="Social links and contact" class="mt-8">
        <ul class="contact list-none pl-0">
          <li><a href={SITE.github} target="_blank" rel="noopener noreferrer me" itemprop="sameAs">GitHub</a></li>
          <li><a href={SITE.linkedin} target="_blank" rel="noopener noreferrer me" itemprop="sameAs">LinkedIn</a></li>
          <li class="with-note">
            <a href={`mailto:${SITE.email}?subject=hi`} itemprop="email">Email</a>
            <span class="text-sm text-muted">(put “hi” in the subject or I won’t see&nbsp;it)</span>
          </li>
          <li><a href={`mailto:${SITE.email}?subject=hi`}>Request my resume</a></li>
        </ul>
      </nav>
    </article>
    <ProjectsKey />
  </div>
  <!-- Sky between the text and the horizon: a share of the room the window leaves, never none. -->
  <div class="min-h-10 flex-[1_1_0] [@media(height<40rem)]:min-h-6" aria-hidden="true"></div>
  <TrafficHorizon />
</Layout>

<style>
  /* Beside the bio once there's room for both; after the links until then. */
  @media (width >= 60rem) {
    .home {
      display: grid;
      grid-template-columns: minmax(0, 34rem) 21rem;
      justify-content: space-between;
      column-gap: 2rem;
      align-items: baseline;
    }
  }

  /* A note that wraps keeps to its own column beside its link, so it never reads as an item. */
  .contact .with-note {
    display: flex;
    align-items: baseline;
    column-gap: 0.5rem;
  }

  /* Each link a comfortable target, on a touch screen a full 44px one. */
  .contact a {
    display: inline-block;
    flex: none;
  }

  @media (pointer: coarse) {
    .contact a {
      padding-block: 0.5rem;
    }
  }
</style>
