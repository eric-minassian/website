---
import Projects from "../components/Projects.astro";
import Layout from "../layouts/Layout.astro";
import { SITE } from "../lib/site";
---

<Layout
  title={`Projects – ${SITE.name}`}
  description="The apps running on Eric Minassian's personal platform, with their page views over the last 30 days."
  page="Projects"
>
  <div class="page mt-2 mb-16">
    <p class="text-muted">Apps I run on my own platform, busiest first.</p>
    <Projects labelledBy="page-heading" />
  </div>
</Layout>
