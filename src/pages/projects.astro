---
import Projects from "../components/Projects.astro";
import Layout from "../layouts/Layout.astro";
import { SITE } from "../lib/site";
---

<Layout
  title={`Projects - ${SITE.name}`}
  description="The apps running on Eric Minassian's personal platform, with their page views over the last 30 days."
>
  <p class="mb-6"><a href="/">{SITE.name}</a></p>
  <h1 id="projects-heading" class="mb-1 text-xl font-medium leading-tight md:text-2xl">Projects</h1>
  <Projects labelledBy="projects-heading" />
</Layout>
